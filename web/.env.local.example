# Sui network
NEXT_PUBLIC_SUI_NETWORK=testnet

# Enoki — required for social-login (Google / Apple / Twitch via zkLogin)
# and sponsored transactions. Get keys at https://portal.enoki.mysten.app/.
#
# TWO keys, two contracts:
#   - PUBLIC key (browser-safe): used for zkLogin sign-in flows in the dapp-kit
#     wallet. Required for Google / Apple / Twitch sign-in to work.
#   - PRIVATE key (server-only, NEVER NEXT_PUBLIC_): used by /api/sponsor and
#     /api/sponsor/execute to sponsor allowlisted transactions. Required for
#     gas-sponsored UX. Configure the allowlist in the Enoki portal.
NEXT_PUBLIC_ENOKI_API_KEY=
ENOKI_PRIVATE_API_KEY=

# OAuth client IDs (only the ones you actually configure in the Enoki portal are used)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-only (never NEXT_PUBLIC_): Google OAuth client secret, if your Enoki
# setup needs it. Keep it out of the browser bundle.
GOOGLE_CLIENT_SECRET=

# Optional overrides for the v3 (hostit_ticket) testnet deploy.
# All default to the values recorded in lib/config.ts — leave unset to use them.
NEXT_PUBLIC_HOSTIT_PACKAGE_ID=
# Shared Hub object (config + 3% fee treasury) — required by every paid sale.
NEXT_PUBLIC_HOSTIT_HUB_ID=
# Circle native USDC coin type. Default = testnet; for mainnet use
# 0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
NEXT_PUBLIC_USDC_COIN_TYPE=

# AI Co-pilot (the organizer assistant in the manage screen). The /api/copilot
# route calls Groq's OpenAI-compatible API; without a key it serves a
# deterministic, data-aware fallback so the feature still works out of the box.
# Set GROQ_API_KEY to unlock full AI answers. Get a key at https://console.groq.com/keys.
# Server-only — NEVER NEXT_PUBLIC_-prefixed (keep it out of the browser bundle).
GROQ_API_KEY=
# Optional: override the Groq model. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# MemWal — organizer "memory" layer (Phase 1). The /api/memory/* routes call a
# MemWal relayer (TEE) that does embedding + SEAL encryption + Walrus storage
# server-side. The layer GRACEFULLY DISABLES (no throw, routes return
# {disabled:true}) until BOTH the delegate key AND account id below are set, so
# the app builds + runs without them.
#
# Server-only — NEVER NEXT_PUBLIC_-prefixed; read via process.env inside
# lib/memwal.ts + the /api/memory/* route handlers only. Keep out of the browser
# bundle (do NOT add to lib/config.ts as an exported constant).

# Ed25519 DELEGATE private key (hex). SERVER-ONLY SECRET — treat like
# ENOKI_PRIVATE_API_KEY / GROQ_API_KEY. Never expose to the client.
MEMWAL_DELEGATE_KEY=

# On-chain MemWalAccount object id. REQUIRED for the memory layer to enable.
# Phase 0 (not done yet) must create the single shared HostIt MemWalAccount and
# put its object id here; until then the layer stays disabled.
MEMWAL_ACCOUNT_ID=

# Relayer (TEE) host. Optional — if unset, the SDK uses its built-in default
# (relayer.memwal.ai).
# UNRESOLVED: the ops env has used `relayer.memory.walrus.xyz` while the SDK
# default is `relayer.memwal.ai`. These differ — confirm the correct relayer
# host and set it explicitly here. Do NOT assume; flagged for resolution.
MEMWAL_RELAYER_URL=

# Shared rate-limit + replay-nonce store (Vercel KV / Upstash Redis REST).
# OPTIONAL: when unset, the limiter falls back to a per-process in-memory counter
# and the replay-nonce store falls back to per-process memory (single-instance
# only — NOT robust on serverless). Set BOTH to enable the shared, cross-instance
# store. Server-only — NEVER NEXT_PUBLIC_-prefixed; read via process.env in
# lib/kvStore.ts only (do NOT add to lib/config.ts).
# For Upstash: REST URL + REST token of the database.
# For Vercel KV: set these to the KV_REST_API_URL / KV_REST_API_TOKEN values.
RATE_LIMIT_KV_REST_URL=
RATE_LIMIT_KV_REST_TOKEN=

# Cloudflare Turnstile — anti-bot bot-wall on the gasless-sponsor + AI routes (#81).
# OPTIONAL: when unset, the bot-wall is DISABLED (dev default). Set BOTH to enable:
#   - the PUBLIC site key (client widget) — safe to expose, NEXT_PUBLIC_-prefixed.
#   - the SECRET key (server-side siteverify) — server-only, NEVER NEXT_PUBLIC_.
# Create a "Managed" widget at https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
